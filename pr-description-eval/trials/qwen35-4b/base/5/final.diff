+    main([str(log_file)])
+    assert not (tmp_path / "cache").exists()
+
+
+def test_cache_ttl_flag(log_file, tmp_path, monkeypatch, capsys):
+    """Test that --cache-ttl flag works correctly."""
+    monkeypatch.setattr(cache, "_get_cache_dir", lambda: tmp_path / "cache")
+    
+    # First run should parse and cache
+    assert main([str(log_file), "--cache", "--cache-ttl", "1", "--count-by", "level"]) == 0
+    first = capsys.readouterr().out
+    assert len(list((tmp_path / "cache").glob("*.json"))) == 1
+    
+    # Second run should use cache
+    def fail(path):
+        raise AssertionError("parse_file should not be called on a cache hit")
+    
+    monkeypatch.setattr("logslice.cli.parse_file", fail)
+    assert main([str(log_file), "--cache", "--cache-ttl", "1", "--count-by", "level"]) == 0
+    assert capsys.readouterr().out == first
+
+
+def test_cache_ttl_expired(log_file, tmp_path, monkeypatch, capsys):
+    """Test that cache entries expire after TTL."""
+    monkeypatch.setattr(cache, "_get_cache_dir", lambda: tmp_path / "cache")
+    
+    # First run should parse and cache
+    assert main([str(log_file), "--cache", "--cache-ttl", "1", "--count-by", "level"]) == 0
+    first = capsys.readouterr().out
+    
+    # Wait for TTL to expire
+    time.sleep(1.1)
+    
+    # Second run should re-parse (cache miss) - parse_file should be called
+    def should_not_be_called(path):
+        raise AssertionError("parse_file should have been called on cache miss")
+    
+    monkeypatch.setattr("logslice.cli.parse_file", should_not_be_called)
+    with pytest.raises(AssertionError):
+        main([str(log_file), "--cache", "--cache-ttl", "1", "--count-by", "level"])
