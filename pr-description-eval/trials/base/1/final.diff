+
+
+def test_cache_ttl_expires_stale_entry(log_file, tmp_path, monkeypatch, capsys):
+    monkeypatch.setenv("LOGSLICE_CACHE_DIR", str(tmp_path / "cache"))
+    assert main([str(log_file), "--cache", "--count-by", "level"]) == 0
+    capsys.readouterr()
+    entry = next((tmp_path / "cache").glob("*.json"))
+    data = json.loads(entry.read_text())
+    data["created_at"] -= 7200  # two hours old
+    entry.write_text(json.dumps(data))
+
+    from logslice.cli import parse_file
+
+    real_parse = parse_file
+    calls = []
+
+    def counting_parse(path):
+        calls.append(path)
+        return real_parse(path)
+
+    monkeypatch.setattr("logslice.cli.parse_file", counting_parse)
+    assert main([str(log_file), "--cache", "--count-by", "level"]) == 0
+    assert calls == [str(log_file)]  # stale entry was re-parsed and re-stored
+
+
+def test_cache_ttl_zero_forces_reparsing(log_file, tmp_path, monkeypatch, capsys):
+    monkeypatch.setenv("LOGSLICE_CACHE_DIR", str(tmp_path / "cache"))
+    assert main([str(log_file), "--cache", "--count-by", "level"]) == 0
+    first = capsys.readouterr().out
+
+    from logslice.cli import parse_file
+
+    real_parse = parse_file
+    calls = []
+
+    def counting_parse(path):
+        calls.append(path)
+        return real_parse(path)
+
+    monkeypatch.setattr("logslice.cli.parse_file", counting_parse)
+    assert main([str(log_file), "--cache", "--cache-ttl", "0", "--count-by", "level"]) == 0
+    assert capsys.readouterr().out == first
+    assert calls == [str(log_file)]
