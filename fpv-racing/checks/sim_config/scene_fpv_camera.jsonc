{
  // Pose-driven FPV camera: one non-physics robot carrying one RGB camera.
  "id": "SceneFpvCamera",
  "actors": [
    {
      "type": "robot",
      "name": "Cam",
      "origin": { "xyz": "0.0 0.0 -1.0", "rpy-deg": "0 0 0" },
      "robot-config": "robot_fpv_camera.jsonc"
    }
  ],
  // steppable + pause-on-start: sim time (and rendering) only advances when the client says so
  "clock": {
    "type": "steppable",
    "step-ns": 10000000,
    "real-time-update-rate": 100000,
    "pause-on-start": true
  },
  "home-geo-point": { "latitude": 47.641468, "longitude": -122.140165, "altitude": 122.0 },
  "scene-type": "UnrealNative"
}
